# Canonical site URL, used for metadata, sitemap and robots.
# Set in Vercel project settings for production.
NEXT_PUBLIC_SITE_URL=https://kelcis.com

# Contact form delivery (Resend). Without this key the form returns an
# error and nothing is sent — set it in Vercel project settings.
RESEND_API_KEY=

# Optional. Defaults are "Kelcis <website@send.kelcis.com>" and the
# address in content/site.ts. The From domain must be verified in Resend;
# keep it on the send. subdomain so it never affects inbound mail.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
